{
  "kind": "collectionType",
  "collectionName": "blogs_posts",
  "info": {
    "singularName": "blogs-post",
    "pluralName": "blogs-posts",
    "displayName": "Blogs Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "resumen": {
      "type": "string"
    },
    "contenido": {
      "type": "blocks"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "autor": {
      "type": "string"
    },
    "fecha": {
      "type": "date"
    },
    "tiempoLectura": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "etiquetas": {
      "type": "json"
    },
    "destacado": {
      "type": "boolean"
    }
  }
}
